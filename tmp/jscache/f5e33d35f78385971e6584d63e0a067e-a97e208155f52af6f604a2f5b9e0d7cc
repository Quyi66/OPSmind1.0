<!DOCTYPE html>
<html lang="zh-cn" ng-app="OplusApp">
<head>
    <meta charset="utf-8"/>
    <title id="oplusAppName">OPLUS</title>
    <meta name="description" content="OPlus is Operation Plus"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
    <meta http-equiv="Access-Control-Allow-Origin" content="*">

    <link id="oplusAppIcon" rel="icon" type="image/png" href="content/images/logo-default.png"/>
    <link rel="apple-touch-icon" href="content/images/logo-default.png"/>
    <link rel="stylesheet" href="content/css/oplus-vendors.css">
    <link rel="stylesheet" href="content/css/oplus-all.css">

    
</head>
<body ng-strict-di ng-cloak ng-controller="MainCtrl as $mainCtrl">
<toaster-container toaster-options="$mainCtrl.toasterOptions"></toaster-container>
<op-desktop
        ng-style="{'background-image':$mainCtrl.uiConfig.backgroundImage,'background-color':$mainCtrl.uiConfig.backgroundColor}"
        ng-if="!$root.$global.hideDesktop && !$root.$global.isAdminUI"></op-desktop>
<div class="opx-layout-vflex">
    <div id="master-header" ui-view="navbar" ng-if="!$root.$global.hideHeader"></div>
    <div id="master-body" ui-view="content" class="opx-flex-fill scroll-y js-spa-body bg-white" style="z-index: 0"
         ng-class="{'hidden':$root.$global.hideMasterContent}">
        <div class="op-blank-slate bg-dark">
            <div class="op-blank-slate-icon"><img src="content/images/preloader.svg" style="width:10rem;"></div>
            <p>正在加载...</p>
        </div>
    </div>
</div>
</body>
