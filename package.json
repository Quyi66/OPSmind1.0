  "scripts": {
    "start": "npm run dev",
    "dev": "webpack serve --config webpack.dev.js --mode development",
    "build": "webpack --config webpack.prod.js --mode production",
    "build-dev": "webpack --config webpack.dev.js --mode development",
    "serve": "webpack serve --config webpack.dev.js --mode development --open",
    "clean": "rimraf dist/ test-package/",
    "analyze": "cross-env ANALYZE=true npm run build && npx webpack-bundle-analyzer dist/webpack-stats.json",
    "analyze:build": "npm run build && node scripts/build-analyzer.js",
    "analyze:bundle": "node scripts/build-analyzer.js --bundle",
    "analyze:quick": "node scripts/build-analyzer.js",
    "analyze:static": "node scripts/analyze-static-assets.js",
    "analyze:assets": "npm run build && node scripts/analyze-static-assets.js",
    "optimize": "node scripts/optimize-dist.js",
    "optimize:build": "npm run build && node scripts/optimize-dist.js",
    "migrate:template": "node scripts/migrate-to-webpack-template.js",
    "watch": "npm run dev",
    "prebuild": "npm run clean",
    "postbuild": "node scripts/copy-node-modules.js && echo '✅ Build completed successfully!' && node scripts/build-analyzer.js && node scripts/optimize-dist.js && node scripts/copy-to-test-package.js",
    "test:config": "node scripts/test-webpack-config.js",
    "dist": "npm run build",
    "test": "echo \"No tests specified\" && exit 0",
    "translator": "node tools/i18n/translator/server.js",
    "detect-cn": "node tools/i18n/detect-cn.js",
    "combine": "node docsify-combine/.bin/cli.js",
    "postinstall": "bash copy-vendor-libs.sh && ln -sf ../../node_modules src/webapp/node_modules"
  },
