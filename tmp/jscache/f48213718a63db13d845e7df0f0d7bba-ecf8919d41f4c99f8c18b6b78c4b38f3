.operation-panel-fixed {
  padding: 0.5rem;
  width: 20%;
}

.operation-panel-drawer {
  position: absolute;
  right: 3px;
  height: calc(100% - 2.5rem);
  border-left: 1px solid #ddd;
  background: #fff;
}

