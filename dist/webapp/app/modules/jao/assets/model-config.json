{
  "code": "",
  "title": "",
  "dataMode": "",
  "attrs": [
    {
      "type": "group",
      "title": "Default"
    },
    {
      "code": "hostname",
      "title": "主机名",
      "input": {
        "control": "input",
        "initval": null
      },
      "unique": false,
      "required": true,
      "internal": false,
      "editable": true
    },
    {
      "code": "ip",
      "title": "IP",
      "unique": true,
      "required": true,
      "internal": true,
      "editable": true,
      "input": {
        "initval": null
      }
    },
    {
      "code": "cpu_cores",
      "title": "CPU核数",
      "input": {
        "initval": null,
        "datatype": "number"
      }
    },
    {
      "code": "online_status",
      "title": "状态",
      "input": {
        "control": "select",
        "sourcedef": "yaml:- [online, 上线]\n- [offline, 下线]",
        "initval": "online",
        "ismultiple": false
      }
    },
    {
      "code": "bizsys",
      "title": "业务系统",
      "input": {
        "control": "select",
        "initval": null,
        "ismultiple": true,
        "sourcedef": "yaml:- [office, Office 365]\n- [bi, Power BI]\n- [mail, Gmail]"
      }
    },
    {
      "type": "group",
      "title": "管理信息"
    },
    {
      "code": "admin",
      "title": "管理员",
      "alias": "责任人,负责人",
      "unique": false,
      "required": false,
      "internal": false,
      "editable": true,
      "input": {
        "initval": null
      }
    },
    {
      "type": "group",
      "title": "维保信息"
    },
    {
      "code": "online_date",
      "title": "上线日期",
      "input": {
        "control": "datepicker",
        "initval": null
      }
    }
  ],
  "views": [
    {
      "type": "list",
      "config": {
        "columns": [
          {
            "attr": "ip"
          },
          {
            "attr": "hostname"
          },
          {
            "attr": "admin"
          }
        ]
      }
    },
    {
      "type": "selector",
      "config": {
        "columns": [
          "ip",
          "admin",
          "hostname"
        ]
      }
    },
    {
      "type": "detail"
    }
  ]
}