m_information}' #System information\\n- inspection_item_type: '#{cac.dashboard.log_system}' #Log system\\n- inspection_item_type: '#{cac.dashboard.file_system}' #File system\\n- inspection_item_type: '#{cac.dashboard.other}' #Other&quot;,&quot;metafields&quot;:&quot;yaml:inspection_item_type: Other\\n&quot;},&quot;params&quot;:[],&quot;eventtorefresh&quot;:&quot;&quot;},&quot;interaction&quot;:{&quot;actions&quot;:[&quot;param&quot;,&quot;event&quot;],&quot;param&quot;:{&quot;params&quot;:&quot;{\\&quot;selectedDatas\\&quot;:\\&quot;js:${inspection_item_type}\\&quot;}&quot;},&quot;activeByIndex&quot;:{&quot;enabled&quot;:true,&quot;index&quot;:1},&quot;event&quot;:{&quot;name&quot;:&quot;cpu_refresh&quot;}},&quot;fields&quot;:{&quot;title&quot;:{&quot;field&quot;:null,&quot;convertFn&quot;:&quot;js:${inspection_item_type} === 'System specification' ? '系统规范' :\\n${inspection_item_type} === 'System information' ? '系统信息' :\\n${inspection_item_type} === 'Log system' ? '日志系统' :\\n${inspection_item_type} === 'File system' ? '文件系统' :\\n${inspection_item_type} === 'Other' ? '其它' : ${inspection_item_type}&quot;}},&quot;display&quot;:{&quot;control&quot;:&quot;pills&quot;,&quot;css&quot;:&quot;mb-3&quot;}}\"></uwidget>\n        <uwidget uw-type=\"kpi\" id=\"w-15929837725793\" uw-props=\"{&quot;_v&quot;:&quot;1.2&quot;,&quot;dataset&quot;:{&quot;_type&quot;:&quot;datax&quot;,&quot;id&quot;:&quot;CAC_DASHBOARD_QUERY_ITEM&quot;,&quot;params&quot;:[{&quot;name&quot;:&quot;template_id&quot;,&quot;initval&quot;:&quot;2c9942a78f054a8b018f4c1e65b801a5&quot;,&quot;datatype&quot;:&quot;string&quot;,&quot;binding&quot;:&quot;&quot;}],&quot;hideParams&quot;:true,&quot;datax&quot;:{&quot;metaparams&quot;:{&quot;template_id&quot;:&quot;2c9942a78f054a8b018f4c1e65b801a5&quot;},&quot;expr&quot;:&quot;js:$$.qdata(\\&quot;CAC_DB_QUERY_ITEM\\&quot;,{template_id:${template_id}},[],null,\\n\\tfunction(data){\\n   //let templateId = ${template_info}\\n  // let hostKeys = ${@.cac_job_info};\\n  //var datasss = ${@}\\n  \\n  /*\\n '#{cac.dashboard.all}'\\n'#{cac.dashboard.system_specification}'\\n'#{cac.dashboard.system_information}'\\n'#{cac.dashboard.log_system}'\\n'#{cac.dashboard.file_system}'\\n'#{cac.dashboard.other}'\\n  */\\n  \\n  // 使用Set来去重  \\n  const uniqueHostKeys = new Set();  \\n  // 遍历数组  \\n  data.records.forEach(item => {  \\n    // 将hostKey添加到Set中，Set会自动去重  \\n    uniqueHostKeys.add(item.hostKey);  \\n  });  \\n  // 将Set转换回数组  \\n  var hostKeys = Array.from(uniqueHostKeys);\\n  \\n  //console.log(\\&quot;shuju-data\\&quot;,uniqueHostKeyArray)\\n // var cac_job_info = $$.qdata(\\&quot;CAC_DB_RUN_HOST\\&quot;,{template_id:${template_id}},[],0,null).then(function (cacJobInfoData) {\\n  //\\tconsole.log(\\&quot;ddddd\\&quot;,cacJobInfoData)\\n   // return cacJobInfoData\\n  //})\\n  \\n\\n \\n  //let hostKeys =${hostKeys}.split(',')\\n  //let hostKeys = ['120.76.178.55', '120.79.228.230', '42.193.162.211', '120.78.159.142', 'e199.oplus-example.com', 'e026.oplus-example.com', 'e100.oplus-example.com', 'e233.oplus-example.com', 'e034.oplus-example.com', 'e007.oplus-example.com']\\n  //let hostKeys = datasss.cac_job_info.hostKeys\\n  //console.log(\\&quot;zzasdf\\&quot;,templateId,\\&quot;阿斯蒂芬\\&quot;);\\n  //var tempType = datasss.selectedDatas\\n  var tempType = \\&quot;ALL\\&quot;\\n  var cac_type = ''\\n  try {  \\n    tempType = ${@.selectedDatas}\\n  } catch (error) {  \\n      console.error('An error occurred:', error);  \\n  } finally {  \\n    cac_type = tempType === undefined ? \\&quot;ALL\\&quot; : tempType === null ? \\&quot;ALL\\&quot; : tempType === '' ? \\&quot;ALL\\&quot; : tempType;\\n  }\\n  var result=[];  \\n  \\n  hostKeys.forEach(function(rec){\\n    let _success = 0;\\n    let _lose = 0;\\n    data.records.forEach(function(rec2){\\n      let _determine = true;\\n      if(\\&quot;ALL\\&quot; !== cac_type &amp;&amp; '#{cac.dashboard.all}' !== cac_type &amp;&amp; '#{cac.dashboard.other}' !== cac_type){\\n        let _A = rec2.name.toLowerCase()\\n        let _B = cac_type.toLowerCase()\\n        _determine = _A.indexOf(_B) !== -1  &amp;&amp; _A.indexOf(\\&quot;-\\&quot;) !== -1;  \\n      }else if('#{cac.dashboard.other}' === cac_type){\\n      \\t_determine = rec2.name.indexOf(\\&quot;-\\&quot;) !== -1;  \\n      }\\n      \\n      if(_determine){\\n        if(rec === rec2.hostKey &amp;&amp; 'OK' === rec2.status){\\n          _success = _success + 1;\\n        }else if(rec === rec2.hostKey &amp;&amp; 'FAILED' === rec2.status){\\n          _lose = _lose + 1;\\n        }\\n      }\\n    });\\n    result.push({hostKey:rec,success:_success,lose:_lose,total:_success + _lose});\\n  });\\n  \\n  return  _.orderBy(result, ['lose'], ['desc']);\\n})\\n\\n\\n\\n&quot;,&quot;metafields&quot;:&quot;yaml:hostKey: e007.oplus-example.com\\nlose: 0\\nsuccess: 15\\ntotal: 15\\n&quot;},&quot;eventtorefresh&quot;:&quot;cpu_refresh&quot;,&quot;paramView&quot;:&quot;hidden&quot;},&quot;interaction&quot;:{&quot;actions&quot;:[],&quot;activeByField&quot;:{&quot;enabled&quot;:false}},&quot;display&quot;:{&quot;rules&quot;:[{&quot;expr&quot;:&quot;${lose} > 0&quot;,&quot;theme&quot;:&quot;danger&quot;},{&quot;expr&quot;:&quot;${lose} < 1&quot;,&quot;theme&quot;:&quot;success&quot;}],&quot;theme&quot;:&quot;black&quot;,&quot;rowNum&quot;:6,&quot;title&quot;:&quot;top&quot;,&quot;height&quot;:&quot;128px&quot;},&quot;fields&quot;:{&quot;text&quot;:{&quot;size&quot;:14,&quot;convertFn&quot;:&quot;js:function(){\\n  var _success=${success}\\n  var _lose=${lose}\\n  var _total=${total}\\n\\n  \\n  //var successPercentage = (_success / _total) * 100;\\n  //var losePercentage = (_lose / _total) * 100;\\n  \\n  //successPercentage = successPercentage.toFixed(2);  \\n  //losePercentage = losePercentage.toFixed(2);\\n\\n  var html='<span class=\\&quot;mr-3\\&quot;><i class=\\&quot;fa fa-check\\&quot;></i> <span>'+ _success +'</span></span>'\\n    +'<span class=\\&quot;mr-3\\&quot;><i class=\\&quot;fa fa-times\\&quot;></i> <span>'+ _lose +'</span></span>';\\n  return html;\\n}&quot;},&quot;title&quot;:{&quot;size&quot;:12,&quot;convertFn&quot;:&quot;js:function(){\\n  var _success = ${success}\\n  var _lose = ${lose}\\n  var style= _lose > 0 ? 'danger' : 'success';\\n  var host_html='<span class=\\&quot;badge badge-'+style+' badge-pill text-sm pull-right\\&quot; style=\\&quot;font-size:18px;\\&quot;>'+${total}+'</span>';\\n  var html='<span>'+${hostKey}+'</span> ' + host_html;\\n  return html;\\n}&quot;}}}\"></uwidget>\n    </div>\n    <div widget-layout=\"layout-flex\" id=\"w-15663504920012\" uw-type=\"layout-flex\" uw-props=\"{&quot;span&quot;:&quot;4&quot;,&quot;display&quot;:{&quot;css&quot;:&quot;mb-3 op-pr&quot;}}\">\n        <uwidget uw-type=\"datatable\" id=\"w-15936790183744\" uw-props=\"{&quot;fields&quot;:[{&quot;field&quot;:&quot;name&quot;},{&quot;field&quot;:&quot;failed_count&quot;,&quot;convertFn&quot;:&quot;js:function(){\\n  var failed_count=${failed_count};\\n  var html='';\\n  var style= failed_count>= 50 ? 'danger': failed_count > 10 ? 'warning' : 'info';\\n  html='<span class=\\&quot;badge badge-'+style+'\\&quot;>'+failed_count+'</span>';\\n  return html;\\n}&quot;}],&quot;display&quot;:{&quot;rules&quot;:[],&quot;cellrules&quot;:[],&quot;height&quot;:&quot;30vh&quot;,&quot;noBorder&quot;:true,&quot;noGrid&quot;:true,&quot;noPageSize&quot;:true,&quot;pagination&quot;:&quot;none&quot;,&quot;noSearch&quot;:true,&quot;cardMode&quot;:true,&quot;noHeader&quot;:true,&quot;bodyHeight&quot;:180},&quot;dataset&quot;:{&quot;_type&quot;:&quot;&quot;,&quot;id&quot;:&quot;CAC_DB_QUERY_FAILED_ITEM&quot;,&quot;params&quot;:[{&quot;name&quot;:&quot;template_id&quot;,&quot;initval&quot;:&quot;2c9942a78f054a8b018f4c1e65b801a5&quot;,&quot;format&quot;:&quot;string&quot;,&quot;binding&quot;:&quot;&quot;}],&quot;datax&quot;:{&quot;metaparams&quot;:{},&quot;expr&quot;:&quot;js:list = [\\n  {'type':'System Specification - Testing90','count':'90'},\\n  {'type':'Logging System - Testing80