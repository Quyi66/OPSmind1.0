# 排除版本控制文件
.git
.gitignore
.gitattributes

# 排除依赖目录（在Dockerfile中重新安装）
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 排除构建产物
output/
dist/
tmp/
build/

# 排除IDE和编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 排除操作系统文件
.DS_Store
Thumbs.db

# 排除日志文件
*.log
logs/

# 排除测试覆盖率报告
coverage/
.nyc_output/

# 排除环境配置文件
.env*
!.env.example

# 排除文档（除非需要）
README.md
CHANGELOG.md
*.md

# 排除Docker相关文件
Dockerfile*
docker-compose*.yml
.dockerignore

# 排除开发工具配置
.eslintrc*
.prettierrc*
.babelrc*
tsconfig.json
webpack.config.js

# 排除缓存文件
.npm
.cache
.temp

# 排除备份文件
*.backup
*.bak
*.tmp

# 排除压缩文件
*.zip
*.tar.gz
*.tgz

# 排除大型媒体文件（可选，根据项目需要调整）
*.mp4
*.avi
*.mov
*.wmv
*.flv

# 排除数据文件（可选）
data/
*.db
*.sqlite 